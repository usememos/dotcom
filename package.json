{
  "name": "memos-dotcom",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "pnpm docs:generate:source && pnpm docs:generate:styles && next build",
    "dev": "NODE_OPTIONS=--max-old-space-size=4096 next dev --turbo",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "build:worker": "opennextjs-cloudflare build",
    "deploy": "node scripts/verify-deploy-env.mjs && opennextjs-cloudflare deploy -- --keep-vars",
    "deploy:dry-run": "pnpm build:worker && wrangler deploy --dry-run",
    "upload": "node scripts/verify-deploy-env.mjs && opennextjs-cloudflare upload -- --keep-vars",
    "typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "smoke": "node scripts/smoke-test.mjs",
    "og:audit": "node scripts/og-audit.mjs",
    "docs:generate:api": "node scripts/generate-api-docs.mjs",
    "docs:generate:source": "fumadocs-mdx",
    "docs:generate:styles": "node scripts/generate-fumadocs-scoped-css.mjs",
    "docs:format:api": "biome format --write content/docs/api",
    "docs:refresh": "pnpm docs:generate:api && pnpm docs:format:api && pnpm docs:generate:source && pnpm docs:generate:styles",
    "postinstall": "pnpm docs:generate:source && pnpm docs:generate:styles",
    "lint": "node scripts/static-revalidate-audit.mjs && node scripts/metadata-title-audit.mjs && biome check",
    "metadata:audit": "node scripts/metadata-title-audit.mjs",
    "format": "biome format --write",
    "check": "biome check --write"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@clerk/nextjs": "^7.8.3",
    "@opennextjs/cloudflare": "1.20.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fumadocs-core": "^16.15.4",
    "fumadocs-mdx": "^15.4.0",
    "fumadocs-openapi": "^11.3.5",
    "fumadocs-ui": "^16.15.4",
    "lucide-react": "^1.37.0",
    "next": "16.3.3",
    "next-themes": "^0.4.6",
    "postcss": "^8.5.26",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shiki": "^4.4.3",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@next/env": "16.3.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "4.127.1"
  }
}
